---
/**
 * Responsive gallery grid with an accessible image lightbox.
 * Without JavaScript the buttons simply do nothing harmful — the images
 * remain visible in the grid, and each thumbnail links to the full image.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { GalleryItem } from '../data/gallery';

interface Props {
  items: GalleryItem[];
  showFilters?: boolean;
}

const { items, showFilters = true } = Astro.props;
const categories = [...new Set(items.map((i) => i.category))];
---

{
  showFilters && (
    <div
      class="mb-8 flex flex-wrap justify-center gap-2"
      role="group"
      aria-label="Filter gallery by category"
    >
      <button
        type="button"
        class="gallery-filter rounded-full border-2 border-navy-800 bg-navy-800 px-4 py-1.5 text-sm font-semibold text-white"
        data-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      {categories.map((cat) => (
        <button
          type="button"
          class="gallery-filter rounded-full border-2 border-navy-200 px-4 py-1.5 text-sm font-semibold text-navy-700 hover:border-navy-800"
          data-filter={cat}
          aria-pressed="false"
        >
          {cat}
        </button>
      ))}
    </div>
  )
}

<ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4" data-gallery-list>
  {
    items.map((item, index) => (
      <li data-category={item.category} class="gallery-item">
        <button
          type="button"
          class="gallery-thumb group relative block w-full overflow-hidden rounded-xl bg-navy-100 text-left"
          data-index={index}
          aria-label={`Open image: ${item.title}`}
        >
          <Image
            src={item.image}
            alt={item.alt}
            width={480}
            height={360}
            format="webp"
            quality={70}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-900/85 to-transparent p-3 pt-8 opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
            <span class="block text-xs font-semibold text-white">{item.title}</span>
            <span class="mt-0.5 block text-[10px] font-medium tracking-wide text-gold-200 uppercase">
              {item.category}
            </span>
          </span>
        </button>
      </li>
    ))
  }
</ul>

<!-- Lightbox dialog -->
<div
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-navy-900/95 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  data-lightbox
>
  <button
    type="button"
    class="absolute top-4 right-4 rounded-full bg-white/10 p-2.5 text-white hover:bg-white/25"
    data-lightbox-close
    aria-label="Close image viewer"
  >
    <Icon name="x" size={22} />
  </button>
  <button
    type="button"
    class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white hover:bg-white/25 sm:left-6"
    data-lightbox-prev
    aria-label="Previous image"
  >
    <Icon name="chevron-down" size={22} class="rotate-90" />
  </button>
  <button
    type="button"
    class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white hover:bg-white/25 sm:right-6"
    data-lightbox-next
    aria-label="Next image"
  >
    <Icon name="chevron-down" size={22} class="-rotate-90" />
  </button>

  <figure class="flex max-h-full w-full max-w-4xl flex-col items-center gap-3">
    <img
      data-lightbox-img
      src=""
      alt=""
      width="1280"
      height="960"
      class="max-h-[75vh] w-auto rounded-lg object-contain shadow-2xl"
    />
    <figcaption class="text-center text-sm text-navy-100">
      <span data-lightbox-title class="block font-semibold text-white"></span>
      <span data-lightbox-meta class="mt-1 block text-xs text-gold-200"></span>
      <span class="mt-1 block text-[11px] text-navy-200">
        Illustrative stock photograph — not an actual photo of this school.
      </span>
    </figcaption>
  </figure>
</div>

<script>
  type Item = { src: string; srcset: string; alt: string; title: string; meta: string };

  const list = document.querySelector<HTMLElement>('[data-gallery-list]');
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  if (list && lightbox) {
    const imgEl = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const titleEl = lightbox.querySelector<HTMLElement>('[data-lightbox-title]');
    const metaEl = lightbox.querySelector<HTMLElement>('[data-lightbox-meta]');
    const thumbs = Array.from(list.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));

    // Collect metadata from the rendered thumbnails (srcset + alt).
    const items: Item[] = thumbs.map((btn) => {
      const img = btn.querySelector('img')!;
      const title = btn.querySelector('.block.text-xs')?.textContent?.trim() ?? '';
      const meta = btn.querySelector('.uppercase')?.textContent?.trim() ?? '';
      return {
        src: img.currentSrc || img.src,
        srcset: img.srcset,
        alt: img.alt,
        title,
        meta,
      };
    });

    let current = 0;
    let lastFocus: HTMLElement | null = null;

    const visibleIndexes = () =>
      thumbs
        .map((t, i) => ((t.closest('.gallery-item') as HTMLElement)?.hidden ? null : i))
        .filter((i): i is number => i !== null);

    function showAtVisiblePos(pos: number) {
      const vis = visibleIndexes();
      if (!vis.length) return;
      let p = pos;
      if (p < 0) p = vis.length - 1;
      if (p >= vis.length) p = 0;
      current = vis[p];
      const item = items[current];
      if (imgEl) {
        if (item.srcset) imgEl.srcset = item.srcset;
        imgEl.src = item.src;
        imgEl.alt = item.alt;
      }
      if (titleEl) titleEl.textContent = item.title;
      if (metaEl) metaEl.textContent = item.meta;
    }

    function currentVisiblePos() {
      const i = visibleIndexes().indexOf(current);
      return i === -1 ? 0 : i;
    }

    function open(index: number) {
      lastFocus = document.activeElement as HTMLElement;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      // Jump straight to the clicked image's visible position
      showAtVisiblePos(Math.max(0, visibleIndexes().indexOf(index)));
      lightbox.querySelector<HTMLElement>('[data-lightbox-close]')?.focus();
    }

    function close() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    thumbs.forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index ?? 0)));
    });

    lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () =>
      showAtVisiblePos(currentVisiblePos() - 1)
    );
    lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () =>
      showAtVisiblePos(currentVisiblePos() + 1)
    );

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') showAtVisiblePos(currentVisiblePos() - 1);
      if (e.key === 'ArrowRight') showAtVisiblePos(currentVisiblePos() + 1);
    });

    // Category filters
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-filter'));
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';
        filterBtns.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('bg-navy-800', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-navy-800', active);
          b.classList.toggle('border-navy-200', !active);
          b.classList.toggle('text-navy-700', !active);
        });
        list.querySelectorAll<HTMLElement>('.gallery-item').forEach((li) => {
          li.hidden = filter !== 'all' && li.dataset.category !== filter;
        });
      });
    });
  }
</script>
