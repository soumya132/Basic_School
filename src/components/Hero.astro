---
/**
 * Hero banner used on the home page (large variant) and as a page header
 * on inner pages (compact variant with breadcrumbs).
 * Uses a responsive <picture> with eager/lazy loading and fixed aspect to
 * avoid layout shift.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  imageAlt: string;
  variant?: 'home' | 'page';
  breadcrumbs?: { label: string; href?: string }[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  title,
  subtitle,
  image,
  imageAlt,
  variant = 'page',
  breadcrumbs,
  primaryCta,
  secondaryCta,
} = Astro.props;

const isHome = variant === 'home';
---

<section
  class:list={[
    'relative isolate overflow-hidden bg-navy-900',
    isHome ? 'min-h-[78vh] sm:min-h-[80vh]' : 'min-h-[34vh]',
  ]}
>
  <!-- Background image (lazy on inner pages, eager on home) -->
  <Image
    src={image}
    alt={imageAlt}
    width={1600}
    format="webp"
    quality={68}
    densities={[1, 1.5]}
    loading={isHome ? 'eager' : 'lazy'}
    fetchpriority={isHome ? 'high' : 'auto'}
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <!-- Contrast overlay -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-900/92 via-navy-900/75 to-navy-900/40"
    aria-hidden="true"
  >
  </div>

  <div class:list={['container-site relative', isHome ? 'py-24 sm:py-32 lg:py-40' : 'py-12 sm:py-16']}>
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}

    <div class="max-w-2xl">
      <h1
        class:list={[
          'font-serif font-bold text-white',
          isHome ? 'text-4xl leading-tight sm:text-5xl lg:text-6xl' : 'text-3xl sm:text-4xl',
        ]}
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class:list={['mt-4 text-navy-100', isHome ? 'text-lg sm:text-xl' : 'text-base']}>
            {subtitle}
          </p>
        )
      }

      {
        (primaryCta || secondaryCta) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {primaryCta && (
              <a
                href={primaryCta.href}
                class="rounded-md bg-gold-400 px-6 py-3 text-sm font-bold text-navy-900 shadow transition-colors hover:bg-gold-200"
              >
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.href}
                class="rounded-md border-2 border-white/70 px-6 py-3 text-sm font-bold text-white transition-colors hover:border-white hover:bg-white/10"
              >
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
