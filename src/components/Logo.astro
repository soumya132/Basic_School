---
/**
 * School logo / wordmark — a simple elegant emblem built from inline SVG.
 * The open-book + rising-sun motif is generic and free of official symbols.
 */
import { school } from '../data/school';

interface Props {
  variant?: 'light' | 'dark';
  showText?: boolean;
  size?: number;
}

const { variant = 'light', showText = true, size = 44 } = Astro.props;
const emblemStroke = variant === 'light' ? '#f3dfab' : '#163255';
const emblemFill = variant === 'light' ? '#ffffff' : '#1f7a46';
const titleColor = variant === 'light' ? 'text-white' : 'text-navy-800';
const subColor = variant === 'light' ? 'text-gold-200' : 'text-leaf-700';
---

<span class="inline-flex items-center gap-3">
  <svg
    width={size}
    height={size}
    viewBox="0 0 48 48"
    role="img"
    aria-label={`${school.name} logo`}
    class="shrink-0"
  >
    <!-- outer ring -->
    <circle cx="24" cy="24" r="22.5" fill="none" stroke={emblemStroke} stroke-width="1.5" />
    <!-- rising sun -->
    <circle cx="24" cy="17" r="5" fill={emblemFill} opacity="0.9" />
    <g stroke={emblemStroke} stroke-width="1.4" stroke-linecap="round">
      <path d="M24 8.5v2.2" />
      <path d="M17.5 11.4l1.3 1.9" />
      <path d="M30.5 11.4l-1.3 1.9" />
      <path d="M14 17.5h2.2" />
      <path d="M31.8 17.5H34" />
    </g>
    <!-- open book -->
    <path
      d="M10 28c4-2.4 8.5-2.4 12 0v9c-3.5-2.4-8-2.4-12 0z"
      fill="none"
      stroke={emblemFill}
      stroke-width="2"
      stroke-linejoin="round"
    />
    <path
      d="M38 28c-4-2.4-8.5-2.4-12 0v9c3.5-2.4 8-2.4 12 0z"
      fill="none"
      stroke={emblemFill}
      stroke-width="2"
      stroke-linejoin="round"
    />
    <path d="M24 28v9" stroke={emblemStroke} stroke-width="1.5" />
  </svg>

  {
    showText && (
      <span class="flex flex-col leading-tight">
        <span class={`font-serif text-base font-bold tracking-wide sm:text-lg ${titleColor}`}>
          {school.name}
        </span>
        <span class={`text-[10px] font-medium tracking-wider uppercase sm:text-[11px] ${subColor}`}>
          Learn · Grow · Shine
        </span>
      </span>
    )
  }
</span>
