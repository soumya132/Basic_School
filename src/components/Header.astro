---
/**
 * Site header: logo, desktop navigation (details-based dropdowns that work
 * without JavaScript) and a mobile menu. A tiny progressive-enhancement
 * script closes menus on Escape / outside click.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navGroups, school } from '../data/school';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const clean = href.replace(/\/$/, '') || '/';
  return pathname === clean || (clean !== '/' && pathname.startsWith(clean + '/'));
}

function groupActive(item: any): boolean {
  if (item.children) return isActive(item.href) || item.children.some((c: any) => isActive(c.href));
  return isActive(item.href);
}
---

<header class="sticky top-0 z-50 border-b border-navy-700/60 bg-navy-800 text-white shadow-md">
  <div class="container-site flex items-center justify-between gap-4 py-3">
    <a href="/" class="rounded-sm" aria-label={`${school.name} — home`}>
      <Logo variant="light" />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main navigation" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navGroups.map((item) =>
            item.children ? (
              <li class="nav-dropdown relative">
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 text-sm font-semibold select-none',
                    groupActive(item)
                      ? 'bg-navy-700 text-gold-200'
                      : 'text-navy-50 hover:bg-navy-700 hover:text-white',
                  ]}
                >
                  {item.label}
                  <Icon name="chevron-down" size={14} class="nav-caret transition-transform" />
                </summary>
                <ul class="dropdown-panel absolute left-0 top-full z-50 mt-1 w-60 rounded-lg border border-navy-100 bg-white py-2 text-navy-800 shadow-xl">
                  {
                    item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block px-4 py-2 text-sm font-medium hover:bg-cream hover:text-leaf-700',
                            isActive(child.href) && 'bg-cream text-leaf-700',
                          ]}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-md px-3 py-2 text-sm font-semibold transition-colors',
                    isActive(item.href)
                      ? 'bg-navy-700 text-gold-200'
                      : 'text-navy-50 hover:bg-navy-700 hover:text-white',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <!-- Mobile menu toggle -->
    <details class="nav-dropdown relative lg:hidden" data-mobile-menu>
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-navy-500 px-3 py-2 text-sm font-semibold text-white select-none"
        aria-label="Toggle navigation menu"
      >
        <Icon name="menu" size={18} class="menu-icon-open" />
        <Icon name="x" size={18} class="menu-icon-close hidden" />
        <span>Menu</span>
      </summary>
      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 top-full mt-2 max-h-[75vh] w-72 overflow-y-auto rounded-lg border border-navy-100 bg-white p-3 text-navy-800 shadow-2xl"
      >
        <ul class="space-y-1">
          {
            navGroups.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-md px-3 py-2 text-sm font-semibold hover:bg-cream',
                    isActive(item.href) && 'bg-cream text-leaf-700',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                {item.children && (
                  <ul class="mb-2 ml-3 mt-1 space-y-1 border-l-2 border-gold-200 pl-3">
                    {item.children
                      .filter((c) => c.href !== item.href)
                      .map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              'block rounded-md px-3 py-1.5 text-sm hover:bg-cream',
                              isActive(child.href) && 'text-leaf-700',
                            ]}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Panels are hidden by default; shown when details is open or on hover/focus */
  .dropdown-panel {
    display: none;
  }
  @media (min-width: 1024px) {
    .nav-dropdown:hover > .dropdown-panel,
    .nav-dropdown:focus-within > .dropdown-panel {
      display: block;
    }
    .nav-dropdown[open] > .dropdown-panel {
      display: block;
    }
  }
  .nav-dropdown[open] > summary .menu-icon-open {
    display: none;
  }
  .nav-dropdown[open] > summary .menu-icon-close {
    display: block;
  }
  .nav-dropdown[open] > summary .nav-caret {
    transform: rotate(180deg);
  }
</style>

<script>
  // Progressive enhancement: close open menus on Escape or outside click.
  function closeAll(except?: HTMLDetailsElement) {
    document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown[open]').forEach((el) => {
      if (el !== except) el.removeAttribute('open');
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (target && !target.closest('.nav-dropdown')) closeAll();
  });
  document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown').forEach((dd) => {
    dd.addEventListener('toggle', () => {
      if (dd.open) closeAll(dd);
    });
  });
</script>
