---
/** Notice card used on the home page and notices page. */
import Icon from './Icon.astro';
import { formatDate, type Notice } from '../data/notices';

interface Props {
  notice: Notice;
  compact?: boolean;
}

const { notice, compact = false } = Astro.props;

const categoryStyles: Record<Notice['category'], string> = {
  Academic: 'bg-navy-50 text-navy-700',
  Holiday: 'bg-leaf-50 text-leaf-700',
  Event: 'bg-gold-100 text-gold-600',
  General: 'bg-slate-100 text-slate-600',
  Examination: 'bg-red-50 text-red-700',
};
---

<article
  class="flex gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
>
  <span
    class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-lg bg-navy-50 font-bold text-navy-700"
    aria-hidden="true"
  >
    <span class="text-[10px] leading-none tracking-wide uppercase"
      >{new Date(notice.date).toLocaleDateString('en-IN', { month: 'short' })}</span
    >
    <span class="text-lg leading-tight">{new Date(notice.date).getDate()}</span>
  </span>

  <div class="min-w-0 flex-1">
    <div class="mb-1.5 flex flex-wrap items-center gap-2">
      <span
        class:list={[
          'rounded-full px-2.5 py-0.5 text-[11px] font-semibold',
          categoryStyles[notice.category],
        ]}
      >
        {notice.category}
      </span>
      <span class="sample-badge">Sample</span>
    </div>
    <h3 class="text-base font-bold text-navy-800">{notice.title}</h3>
    {!compact && <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{notice.summary}</p>}
    <p class="mt-2 flex items-center gap-1.5 text-xs text-slate-500">
      <Icon name="calendar" size={13} />
      <time datetime={notice.date}>{formatDate(notice.date)}</time>
    </p>
  </div>
</article>
