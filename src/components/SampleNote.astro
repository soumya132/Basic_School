---
/**
 * A small banner explaining that nearby content is illustrative/sample.
 * Used wherever fictional content could be mistaken for official claims.
 */
interface Props {
  text?: string;
  compact?: boolean;
}

const {
  text = 'The content on this page is illustrative sample copy for website preview. It is not an official school claim until verified and updated by the school.',
  compact = false,
} = Astro.props;
---

<aside
  class:list={[
    'flex items-start gap-3 rounded-lg border border-gold-200 bg-gold-100/70',
    compact ? 'px-3.5 py-2.5 text-xs' : 'px-4 py-3.5 text-sm',
  ]}
  role="note"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="mt-0.5 shrink-0 text-gold-600"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 16v-4"></path>
    <path d="M12 8h.01"></path>
  </svg>
  <p class="leading-relaxed text-gold-600"><strong class="font-bold">Sample content:</strong> {text}</p>
</aside>
