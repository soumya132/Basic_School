---
/** Contact information block (address, phone, email, office hours). */
import Icon from './Icon.astro';
import type { IconName } from '../types';
import { school } from '../data/school';

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;

const items: { icon: IconName; label: string; value: string; href?: string }[] = [
  {
    icon: 'map-pin',
    label: 'School Address',
    value: `${school.address.line1}, ${school.address.line2}, ${school.address.city}, ${school.address.state} — ${school.address.pincode}`,
  },
  {
    icon: 'phone',
    label: 'Telephone',
    value: school.phone,
    href: school.phone.startsWith('[') ? undefined : `tel:${school.phone}`,
  },
  {
    icon: 'mail',
    label: 'Email',
    value: school.email,
    href: school.email.startsWith('[') ? undefined : `mailto:${school.email}`,
  },
  {
    icon: 'clock',
    label: 'Office Hours',
    value: `${school.officeDays} · ${school.officeHours}`,
  },
];

const isPlaceholder = (v: string) => v.includes('[');
---

<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  {
    showHeading && (
      <h2 class="mb-6 text-xl font-bold text-navy-800">School Contact Information</h2>
    )
  }
  <ul class="space-y-5">
    {
      items.map((item) => (
        <li class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-leaf-50 text-leaf-700">
            <Icon name={item.icon} size={20} />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-bold tracking-wider text-slate-500 uppercase">{item.label}</p>
            {isPlaceholder(item.value) ? (
              <p class="placeholder-text mt-1 inline-block text-sm">{item.value}</p>
            ) : item.href ? (
              <a href={item.href} class="mt-1 block text-sm font-semibold text-navy-700 hover:text-leaf-700 hover:underline">
                {item.value}
              </a>
            ) : (
              <p class="mt-1 text-sm font-semibold text-navy-800">{item.value}</p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
  <p class="mt-6 rounded-lg bg-cream px-4 py-3 text-xs leading-relaxed text-slate-600">
    Details shown in <span class="placeholder-text">[brackets]</span> are editable placeholders.
    Replace them in <code class="rounded bg-cream-dark px-1 py-0.5">src/data/school.ts</code>
    with verified information before publishing.
  </p>
</div>
