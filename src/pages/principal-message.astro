---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTASection from '../components/CTASection.astro';
import SampleNote from '../components/SampleNote.astro';
import { images } from '../data/gallery';
import { school } from '../data/school';
---

<BaseLayout
  title="Principal's Message"
  description={`Read the principal's message at ${school.name} — a warm welcome to parents and students from the school leadership.`}
>
  <Hero
    title="Principal's Message"
    subtitle="A few words from the head of our school."
    image={images.assembly}
    imageAlt="Students gathered for a school assembly (illustrative stock photograph)"
    breadcrumbs={[{ label: "Principal's Message" }]}
  />

  <section class="section bg-white">
    <div class="container-site mx-auto max-w-4xl">
      <SampleNote
        text="the message below is sample placeholder copy. Replace it with the principal's verified message and photograph before publishing."
      />

      <div class="mt-10 grid gap-10 sm:grid-cols-[240px_1fr]">
        <div class="mx-auto sm:mx-0">
          <!-- Placeholder portrait -->
          <div
            class="flex aspect-square w-48 items-center justify-center rounded-2xl border-2 border-dashed border-navy-200 bg-cream text-center sm:w-full"
          >
            <div class="px-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mx-auto text-navy-300"
                aria-hidden="true"
              >
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <p class="mt-3 text-xs font-semibold text-navy-400">[Add principal's photo]</p>
            </div>
          </div>
          <div class="mt-4 text-center sm:text-left">
            <p class="font-serif text-lg font-bold text-navy-800">{school.principalName}</p>
            <p class="text-sm text-leaf-700">{school.principalTitle}</p>
            <p class="placeholder-text mt-1 inline-block text-xs">{school.name}</p>
          </div>
        </div>

        <div class="relative">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="40"
            height="40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mb-4 text-gold-400"
            aria-hidden="true"
          >
            <path
              d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1a1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v1a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"
            ></path>
            <path
              d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h1a1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v1a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"
            ></path>
          </svg>

          <div class="prose-school">
            <p class="text-lg leading-relaxed text-navy-800">
              Dear parents, guardians and well-wishers,
            </p>
            <p>
              It gives me great joy to welcome you to the website of
              <strong>{school.name}</strong>. A school is more than buildings and classrooms —
              it is a community of children, teachers and families who trust one another with
              something very precious: a child's growing years.
            </p>
            <p>
              <em
                >[This is placeholder text. Replace it with the principal's own message — for
                example, their thoughts on education, a welcome to new families, or the goals
                for the coming academic year.]</em
              >
            </p>
            <p>
              We hope this website helps you understand who we are and what we stand for. If you
              have any questions, please do visit or call the school office — we are always happy
              to talk.
            </p>
            <p class="pt-4">
              With warm regards,<br />
              <strong>{school.principalName}</strong><br />
              {school.principalTitle}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Visit our campus"
    text="The best way to know a school is to see it in action. Contact the office to arrange a visit."
    primary={{ label: 'Contact Us', href: '/contact' }}
    secondary={{ label: 'Meet Our Faculty', href: '/faculty' }}
  />
</BaseLayout>
