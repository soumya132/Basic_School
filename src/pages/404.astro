---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { school } from '../data/school';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist. Return to the home page of Saraswati Sisu Vidya Mandir."
>
  <section class="section bg-white">
    <div class="container-site text-center">
      <p class="text-sm font-bold tracking-[0.3em] text-leaf-600 uppercase">404</p>
      <h1 class="mt-4 text-4xl font-bold text-navy-800 sm:text-5xl">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-slate-600">
        Sorry, we couldn't find the page you're looking for. It may have been moved or doesn't
        exist.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-md bg-navy-800 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-navy-700"
        >
          <Icon name="home" size={18} />
          Go to Home
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-md border-2 border-navy-200 px-6 py-3 text-sm font-bold text-navy-800 transition-colors hover:border-navy-800"
        >
          <Icon name="phone" size={18} />
          Contact Us
        </a>
      </div>

      <div class="mt-12">
        <p class="text-sm font-semibold text-navy-700">Quick links</p>
        <nav aria-label="Quick links from 404 page" class="mt-3 flex flex-wrap justify-center gap-4 text-sm">
          <a href="/about" class="text-leaf-700 hover:underline">About Us</a>
          <a href="/academics" class="text-leaf-700 hover:underline">Academics</a>
          <a href="/notices" class="text-leaf-700 hover:underline">News & Notices</a>
          <a href="/gallery" class="text-leaf-700 hover:underline">Gallery</a>
          <a href="/school-information" class="text-leaf-700 hover:underline">School Information</a>
        </nav>
      </div>

      <p class="mt-10 text-xs text-slate-400">{school.name}</p>
    </div>
  </section>
</BaseLayout>
